{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrintVerse Desktop Pet",
  "version": "0.1.0",
  "identifier": "com.printverse.desktop",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "PrintVerse Desktop Pet",
        "url": "http://127.0.0.1:4173/?pet=1",
        "width": 620,
        "height": 760,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "PrintVerse",
    "shortDescription": "PrintVerse Desktop Pet"
  }
}